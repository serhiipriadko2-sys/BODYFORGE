import { type CounterFeedback, type CounterPhase, type CounterSnapshot, type KneeSide, type PosePoint } from './squatCounter';
import { type ExerciseId } from './trainingCatalog';

const CONFIDENCE = 0.5;
const LOST_MS = 750;
// An unobserved finish must never complete a repetition. Two slow frames remain acceptable.
const PARTIAL_MOTION_GAP_MS = 400;
const READY_MS = 160;
const ENGAGED_MS = 100;
const RETURN_MS = 90;
const REP_MS = 390;
const HOLD_TARGET_SECONDS = 30;
// Existing floor-view ratio from leg-raise; reuse it for crunch phase geometry.
const FLOOR_TORSO_RATIO = 1.15;
// Reject degenerate/noisy joints while allowing a valid full-body pose at a
// greater camera distance. 0.065 excluded forearms and shins at ~40% scale.
const MIN_SEGMENT_LENGTH = 0.04;
// Shared minimum silhouette sizes for jumping-jack detection and framing advice.
export const MIN_JACK_SHOULDER_WIDTH = .025;
export const MIN_JACK_TORSO_HEIGHT = .045;
// Existing framing warning margin, also used for pushup eligibility.
export function nearExerciseFrameEdge(p: PosePoint): boolean {
  return p.x < .035 || p.x > .965 || p.y < .035 || p.y > .965;
}

type Side = KneeSide;
interface Reading { metric: number; ready: boolean; engaged: boolean; side: Side | null }
type LandmarkSet = PosePoint[];

const valid = (p: PosePoint | undefined): p is PosePoint =>
  !!p && Number.isFinite(p.x) && Number.isFinite(p.y) &&
  p.x >= 0.01 && p.x <= 0.99 && p.y >= 0.01 && p.y <= 0.99 &&
  Number.isFinite(p.visibility ?? 1) && (p.visibility ?? 1) >= CONFIDENCE &&
  Number.isFinite(p.presence ?? 1) && (p.presence ?? 1) >= 0.45;
const visible = (p: LandmarkSet, ...indexes: number[]) => indexes.every((index) => valid(p[index]));
const xy = (p: PosePoint, ratio: number) => ({ x: p.x * ratio, y: p.y });
function angle(a: PosePoint, b: PosePoint, c: PosePoint, ratio: number): number {
  const aa = xy(a, ratio), bb = xy(b, ratio), cc = xy(c, ratio);
  const radians = Math.atan2(aa.y - bb.y, aa.x - bb.x) - Math.atan2(cc.y - bb.y, cc.x - bb.x);
  const degrees = Math.abs(radians * 180 / Math.PI);
  return degrees > 180 ? 360 - degrees : degrees;
}
function measuredAngle(p: LandmarkSet, a: number, b: number, c: number, ratio: number): number | null {
  if (!visible(p, a, b, c)) return null;
  const pa = p[a], pb = p[b], pc = p[c];
  if (Math.hypot((pa.x - pb.x) * ratio, pa.y - pb.y) < MIN_SEGMENT_LENGTH ||
      Math.hypot((pc.x - pb.x) * ratio, pc.y - pb.y) < MIN_SEGMENT_LENGTH) return null;
  return angle(pa, pb, pc, ratio);
}
const sides = [
  { side: 'left' as Side, shoulder: 11, elbow: 13, wrist: 15, hip: 23, knee: 25, ankle: 27 },
  { side: 'right' as Side, shoulder: 12, elbow: 14, wrist: 16, hip: 24, knee: 26, ankle: 28 },
];
function horizontalBody(p: LandmarkSet, s: typeof sides[number], ratio: number) {
  const required = [s.shoulder, s.elbow, s.wrist, s.hip, s.ankle];
  if (!visible(p, ...required) || required.some(i => nearExerciseFrameEdge(p[i]) ||
      (p[i].visibility ?? 1) > 1 || (p[i].presence ?? 1) > 1)) return false;
  const shoulder = p[s.shoulder], ankle = p[s.ankle];
  // In an upright camera image the supporting wrist must be below the shoulder.
  // This projection check cannot establish actual weight bearing or floor contact.
  if (p[s.wrist].y <= shoulder.y) return false;
  return Math.abs((shoulder.x - ankle.x) * ratio) > Math.abs(shoulder.y - ankle.y) * 1.35 &&
    (measuredAngle(p, s.shoulder, s.hip, s.ankle, ratio) ?? 0) >= 145;
}
function sidesReading(p: LandmarkSet, ratio: number, id: ExerciseId, locked: Side | null): Reading | null {
  const readings: Reading[] = [];
  for (const s of sides) {
    let value: number | null = null;
    if (id === 'lunge') value = measuredAngle(p, s.hip, s.knee, s.ankle, ratio);
    if (id === 'pushup') {
      if (!horizontalBody(p, s, ratio)) continue;
      value = measuredAngle(p, s.shoulder, s.elbow, s.wrist, ratio);
    }
    if (id === 'crunch') {
      const required = [s.shoulder, s.hip, s.knee, s.ankle];
      if (!visible(p, ...required) || required.some(i => nearExerciseFrameEdge(p[i]) ||
          (p[i].visibility ?? 1) > 1 || (p[i].presence ?? 1) > 1)) continue;
      const shoulder = p[s.shoulder], hip = p[s.hip], kneePoint = p[s.knee], ankle = p[s.ankle];
      // Floor-view proxy: bent knee above hip and ankle in the image.
      // These are observation constraints, not proof of contact with the floor.
      if (kneePoint.y >= hip.y || kneePoint.y >= ankle.y) continue;
      const knee = measuredAngle(p, s.hip, s.knee, s.ankle, ratio);
      if (knee === null || knee < 45 || knee > 145) continue;
      value = measuredAngle(p, s.shoulder, s.hip, s.knee, ratio);
      if (value === null) continue;
      // The shoulder-hip vector must itself change projection class. A knee
      // moving toward a stationary torso cannot arm a repetition.
      const horizontal = Math.abs((shoulder.x - hip.x) * ratio) >= Math.abs(shoulder.y - hip.y) * FLOOR_TORSO_RATIO;
      readings.push({
        metric: value, ready: value >= 132 && horizontal,
        engaged: value <= 103 && !horizontal && shoulder.y < hip.y, side: s.side,
      });
      continue;
    }
    if (id === 'leg-raise') {
      const required = [s.shoulder, s.hip, s.knee, s.ankle];
      if (!visible(p, ...required) || required.some(i => nearExerciseFrameEdge(p[i]) ||
          (p[i].visibility ?? 1) > 1 || (p[i].presence ?? 1) > 1)) continue;
      const shoulder = p[s.shoulder], hip = p[s.hip], kneePoint = p[s.knee], ankle = p[s.ankle];
      if (Math.abs((shoulder.x - hip.x) * ratio) < Math.abs(shoulder.y - hip.y) * FLOOR_TORSO_RATIO) continue;
      const knee = measuredAngle(p, s.hip, s.knee, s.ankle, ratio);
      if (knee === null || knee < 145) continue;
      value = measuredAngle(p, s.shoulder, s.hip, s.ankle, ratio);
      if (value === null) continue;
      // Require independent change of the projected hip-to-ankle vector:
      // torso motion alone must not satisfy both phases. Reuse the existing
      // floor-view ratio; this is a geometric proxy, not a field calibration.
      const horizontalLeg = Math.abs((ankle.x - hip.x) * ratio) >= Math.abs(ankle.y - hip.y) * FLOOR_TORSO_RATIO;
      readings.push({
        metric: value, ready: value >= 150 && horizontalLeg,
        engaged: value <= 110 && !horizontalLeg && ankle.y < kneePoint.y && kneePoint.y < hip.y,
        side: s.side,
      });
      continue;
    }
    if (value === null) continue;
    const activeThreshold = id === 'lunge' ? 113 : 108;
    readings.push({ metric: value, ready: value >= 151, engaged: value <= activeThreshold, side: s.side });
  }
  if (id === 'lunge') {
    // This experimental one-leg-bend prototype needs both legs in every phase.
    // Unknown/ambiguous observations are not proof of a completed motion.
    if (readings.length !== 2 || [23, 24, 25, 26, 27, 28].some(i =>
        (p[i].visibility ?? 1) > 1 || (p[i].presence ?? 1) > 1)) return null;
    const engaged = readings.filter(r => r.engaged);
    if (engaged.length > 1) return null; // no defensible active-side identity
    // Report the observed active side even when another side was locked.
    // The FSM must reject a side substitution, not silently mask it.
    const chosen = engaged[0] ?? readings.find(r => r.side === locked) ?? readings[0];
    return { ...chosen, ready: readings.every(r => r.ready) };
  }
  if (locked) return readings.find((r) => r.side === locked) ?? null;
  return readings.find((r) => r.engaged) ?? readings[0] ?? null;
}
function jackReading(p: LandmarkSet, ratio: number): Reading | null {
  const required = [11, 12, 15, 16, 23, 24, 27, 28];
  if (!visible(p, ...required) || required.some(i => nearExerciseFrameEdge(p[i]) ||
      (p[i].visibility ?? 1) > 1 || (p[i].presence ?? 1) > 1)) return null;
  // Require an upright projection, not merely a large ankle separation.
  // This cannot determine foot contact or whether a person is airborne.
  if (p[27].y <= p[23].y || p[28].y <= p[24].y) return null;
  const shoulderWidth = Math.abs(p[11].x - p[12].x) * ratio;
  const shoulders = (p[11].y + p[12].y) / 2;
  const hips = (p[23].y + p[24].y) / 2;
  const torsoHeight = hips - shoulders;
  // Use a person's visible size, not fixed fractions of the camera frame.
  // Otherwise a complete jumping jack stops working as the person steps back.
  // Keep lower pixel-scale floors to reject tiny/noisy MediaPipe silhouettes.
  if (shoulderWidth < MIN_JACK_SHOULDER_WIDTH || torsoHeight < MIN_JACK_TORSO_HEIGHT) return null;
  const feet = Math.abs(p[27].x - p[28].x) * ratio / shoulderWidth;
  const armTravel = Math.max(.018, torsoHeight * .42);
  const armsUp = p[15].y < shoulders - armTravel && p[16].y < shoulders - armTravel;
  const armsDown = p[15].y > shoulders + armTravel && p[16].y > shoulders + armTravel;
  return { metric: feet, ready: feet < 1.12 && armsDown, engaged: feet > 1.70 && armsUp, side: null };
}
function kneesReading(p: LandmarkSet): Reading | null {
  const required = [23, 24, 25, 26, 27, 28];
  if (!visible(p, ...required) || required.some(i => nearExerciseFrameEdge(p[i]) ||
      (p[i].visibility ?? 1) > 1 || (p[i].presence ?? 1) > 1)) return null;
  // Upright front/oblique projection: a visible ankle must be below its knee.
  // This is an observation constraint, not a contact or biomechanics test.
  if (p[27].y <= p[25].y || p[28].y <= p[26].y) return null;
  // Normalize knee height by the visible straight supporting leg. Pixel/normalized
  // Y thresholds used to fail simply because the athlete stepped farther away.
  const leftLegHeight = p[27].y - p[23].y;
  const rightLegHeight = p[28].y - p[24].y;
  const leftDrop = p[25].y - p[23].y;
  const rightDrop = p[26].y - p[24].y;
  const leftDown = leftLegHeight >= .065 && leftDrop > leftLegHeight * .43;
  const rightDown = rightLegHeight >= .065 && rightDrop > rightLegHeight * .43;
  // No reliable supporting-side identity when neither leg is lowered.
  if (!leftDown && !rightDown) return null;
  const leftUp = rightDown && leftDrop < rightLegHeight * .25;
  const rightUp = leftDown && rightDrop < leftLegHeight * .25;
  if (leftUp && !rightUp) return {
    metric: Math.max(0, Math.min(120, (1 - leftDrop / rightLegHeight) * 100)),
    ready: false, engaged: true, side: 'left',
  };
  if (rightUp && !leftUp) return {
    metric: Math.max(0, Math.min(120, (1 - rightDrop / leftLegHeight) * 100)),
    ready: false, engaged: true, side: 'right',
  };
  return { metric: 0, ready: leftDown && rightDown, engaged: false, side: null };
}
function plankReading(p: LandmarkSet, ratio: number): Reading | null {
  let invalidSide: Reading | null = null;
  for (const s of sides) {
    if (!visible(p, s.shoulder, s.elbow, s.hip, s.ankle)) continue;
    const a = measuredAngle(p, s.shoulder, s.hip, s.ankle, ratio);
    const shoulder = p[s.shoulder], ankle = p[s.ankle], elbow = p[s.elbow];
    if (a === null) continue;
    const horizontal = Math.abs((shoulder.x - ankle.x) * ratio) >= Math.abs(shoulder.y - ankle.y) * 1.5;
    const support = elbow.y > shoulder.y + .025 &&
      Math.abs((elbow.x - shoulder.x) * ratio) < .27;
    const acceptable = horizontal && support && a >= 157;
    const candidate = { metric: a, ready: acceptable, engaged: acceptable, side: s.side };
    if (acceptable) return candidate;
    invalidSide ??= candidate;
  }
  return invalidSide;
}

/** Geometric prototypes. They measure 2-D projections, not medically verified technique. */
export function measureExercise(
  id: ExerciseId, points: LandmarkSet, aspectRatio = 1, side: Side | null = null,
): Reading | null {
  if (!Number.isFinite(aspectRatio) || aspectRatio <= 0 || aspectRatio > 5) return null;
  if (id === 'jumping-jack') return jackReading(points, aspectRatio);
  if (id === 'high-knees') return kneesReading(points);
  if (id === 'plank') return plankReading(points, aspectRatio);
  if (id === 'squat') return null; // The existing adaptive SquatCounter is authoritative.
  return sidesReading(points, aspectRatio, id, side);
}

export interface ExerciseReading {
  snapshot: CounterSnapshot;
  side: Side | null;
  metricName: string;
  metricUnit: string;
  tracking: boolean;
}
const metricNames: Record<Exclude<ExerciseId, 'squat'>, string> = {
  lunge: 'КОЛЕНО', pushup: 'ЛОКОТЬ', 'jumping-jack': 'РАЗВОДКА',
  'high-knees': 'ВЫСОТА', crunch: 'КОРПУС', 'leg-raise': 'ТАЗ', plank: 'КОРПУС',
};
const metricUnits: Record<Exclude<ExerciseId, 'squat'>, string> = {
  lunge: '°', pushup: '°', 'jumping-jack': '×', 'high-knees': '%',
  crunch: '°', 'leg-raise': '°', plank: '°',
};

export function exerciseMetric(id: ExerciseId): { name: string; unit: string } {
  return id === 'squat' ? { name: 'КОЛЕНО', unit: '°' }
    : { name: metricNames[id], unit: metricUnits[id] };
}

export class ExerciseMotionCounter {
  private phase: CounterPhase = 'calibrate';
  private count = 0;
  private readyAt: number | null = null;
  private engagedAt: number | null = null;
  private returnAt: number | null = null;
  private lastVisibleAt: number | null = null;
  private lastRepAt = Number.NEGATIVE_INFINITY;
  private lockedSide: Side | null = null;
  private previousKnee: Side | null = null;
  private holdMs = 0;
  private holdAt: number | null = null;
  private lastTime = Number.NEGATIVE_INFINITY;
  constructor(readonly id: Exclude<ExerciseId, 'squat'>) {}

  private forgetPartial(): void {
    this.phase = 'calibrate';
    this.readyAt = null;
    this.engagedAt = null;
    this.returnAt = null;
    this.lockedSide = null;
    this.holdAt = null;
    if (this.id === 'plank') { this.holdMs = 0; this.count = 0; }
  }
  reset(): void {
    this.forgetPartial();
    this.count = 0;
    this.lastVisibleAt = null;
    this.lastRepAt = Number.NEGATIVE_INFINITY;
    this.previousKnee = null;
    this.lastTime = Number.NEGATIVE_INFINITY;
  }
  recalibrate(): ExerciseReading {
    this.forgetPartial();
    this.lastVisibleAt = null;
    return this.result('stand', false, null);
  }
  private result(feedback: CounterFeedback, counted: boolean, metric: number | null): ExerciseReading {
    const snapshot: CounterSnapshot = {
      count: this.count, phase: this.phase, feedback, angle: metric === null ? null : Math.round(metric * 10) / 10,
      counted, calibrated: this.phase !== 'calibrate', standingAngle: null, depthTarget: null,
      returnTarget: null, lowestAngle: null,
    };
    return {
      snapshot, side: this.lockedSide, metricName: metricNames[this.id], metricUnit: metricUnits[this.id],
      tracking: metric !== null,
    };
  }
  update(points: LandmarkSet, now: number, ratio = 1): ExerciseReading {
    if (!Number.isFinite(now) || now < 0 || now <= this.lastTime) return this.result('find-body', false, null);
    this.lastTime = now;
    const lockCalibrationSide = this.id === 'pushup' || this.id === 'crunch' || this.id === 'leg-raise';
    const strictMotion = lockCalibrationSide || this.id === 'lunge' || this.id === 'jumping-jack' || this.id === 'high-knees';
    if (this.lastVisibleAt !== null && now - this.lastVisibleAt >
        (strictMotion || (this.id !== 'plank' && (this.phase === 'descending' || this.phase === 'bottom'))
          ? PARTIAL_MOTION_GAP_MS : LOST_MS)) this.forgetPartial();
    const reading = measureExercise(this.id, points, ratio, this.id === 'high-knees' || this.id === 'plank' ? null : this.lockedSide);
    if (!reading) {
      if (strictMotion) {
        // An unobserved or ambiguous motion cannot supply a completed phase.
        // Preserve finished repetitions, but require fresh calibration.
        this.forgetPartial();
        this.lastVisibleAt = null;
      }
      if (this.id === 'plank') {
        // One noisy MediaPipe frame must not erase an honest hold. Pause rather
        // than credit unseen time; longer tracking loss restarts from zero.
        if (this.phase === 'bottom' && this.lastVisibleAt !== null && now - this.lastVisibleAt <= 300)
          this.holdAt = null;
        else this.forgetPartial();
      }
      return this.result('find-body', false, null);
    }
    this.lastVisibleAt = now;
    if (this.id === 'plank') {
      if (!reading.ready) {
        this.forgetPartial();
        return this.result('stand', false, reading.metric);
      }
      if (this.phase === 'calibrate') {
        this.readyAt ??= now;
        if (now - this.readyAt >= 300) { this.phase = 'bottom'; this.holdAt = now; }
        return this.result('stand', false, reading.metric);
      }
      // Only fresh validated video frames can advance a continuous hold.
      if (this.holdAt !== null && now - this.holdAt > 450) {
        this.forgetPartial();
        return this.result('stand', false, reading.metric);
      }
      this.holdMs += Math.max(0, Math.min(180, now - (this.holdAt ?? now)));
      this.holdAt = now;
      const before = this.count;
      this.count = Math.min(HOLD_TARGET_SECONDS, Math.floor(this.holdMs / 1000));
      return this.result('rise', this.count > before, reading.metric);
    }

    let feedback: CounterFeedback = 'stand';
    let counted = false;
    switch (this.phase) {
      case 'calibrate':
        if (reading.ready) {
          this.readyAt ??= now;
          // Floor exercises must use one observed side throughout calibration and motion.
          if (lockCalibrationSide) this.lockedSide ??= reading.side;
          if (now - this.readyAt >= READY_MS) this.phase = 'ready';
        } else {
          this.readyAt = null;
          if (lockCalibrationSide) this.lockedSide = null;
        }
        feedback = this.phase === 'ready' ? 'go-down' : 'stand';
        break;
      case 'ready':
        feedback = 'go-down';
        if (reading.engaged && !(this.id === 'high-knees' && reading.side === this.previousKnee)) {
          this.phase = 'descending';
          this.engagedAt = now;
          this.lockedSide = reading.side;
          feedback = 'lower';
        }
        break;
      case 'descending':
        feedback = 'lower';
        if ((this.id === 'high-knees' || this.id === 'lunge') && reading.engaged && reading.side !== this.lockedSide) {
          this.forgetPartial();
          feedback = 'stand';
          break;
        }
        if (strictMotion) {
          // Do not add time from two disconnected bends to the active hold.
          if (reading.engaged) this.engagedAt ??= now;
          else this.engagedAt = null;
        }
        if (reading.engaged && this.engagedAt !== null && now - this.engagedAt >= ENGAGED_MS) {
          this.phase = 'bottom';
          this.returnAt = null;
          feedback = 'rise';
        } else if (reading.ready) {
          this.phase = 'ready'; this.engagedAt = null;
          if (!lockCalibrationSide) this.lockedSide = null;
        }
        break;
      case 'bottom':
        feedback = 'rise';
        if ((this.id === 'high-knees' || this.id === 'lunge') && reading.engaged && reading.side !== this.lockedSide) {
          this.forgetPartial();
          feedback = 'stand';
          break;
        }
        if (reading.ready) {
          this.returnAt ??= now;
          if (now - this.returnAt >= RETURN_MS &&
              this.engagedAt !== null && now - this.engagedAt >= REP_MS &&
              now - this.lastRepAt >= REP_MS) {
            this.count++;
            this.lastRepAt = now;
            if (this.id === 'high-knees') this.previousKnee = this.lockedSide;
            this.phase = 'ready';
            this.engagedAt = null; this.returnAt = null;
            if (!lockCalibrationSide) this.lockedSide = null;
            counted = true; feedback = 'great';
          }
        } else this.returnAt = null;
        break;
    }
    return this.result(feedback, counted, reading.metric);
  }
}
