{
  "hosting": {
    "site": "bodyforge-mobile-20261022",
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] },
      { "source": "/build-info.json", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
    ]
  }
}
